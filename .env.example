# Grid Backend Configuration
# Copy this file to .env and customize

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///gridbackend.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gridbackend

# Debug mode (enables debug endpoints and auto-zone creation)
DEBUG_MODE=true
DEBUG_USER=player1

# Security (change in production!)
# SECRET_KEY=your-secret-key-here

# Tick rate in milliseconds
# TICK_RATE_MS=1000

# Game logic module
# GAME_MODULE=grid_backend.game_modules.example
